<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Sicherheits-Header für Plesk / Apache
  <IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
  </IfModule>

  # API-Endpunkte auf Plesk an PHP-Skripte weiterleiten
  RewriteRule ^api/login/?$ api/login.php [L,QSA]
  RewriteRule ^api/admin/login/?$ api/login.php [L,QSA]
  RewriteRule ^api/cms/?$ api/cms.php [L,QSA]

  # Statische Dateien und Ordner direkt ausliefern
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Alle Unterseiten (/produkte/..., /werkstoffe/..., /downloads, /karriere, /admin) an index.html leiten
  RewriteRule ^ index.html [L]
</IfModule>
